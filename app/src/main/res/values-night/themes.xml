<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      系统深色模式下的启动窗口主题：深色底 + 浅色系统栏图标。
      与 values/themes.xml 成对存在，保证启动窗口在两种系统模式下「底色 × 图标」始终有对比。
      运行期的系统栏图标由 ui/SystemBarAppearance.kt 按 App 主题显式驱动。
    -->
    <style name="Theme.Yanji" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/yanji_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
