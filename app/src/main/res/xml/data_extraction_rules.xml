<?xml version="1.0" encoding="utf-8"?>
<!--
  数据提取规则（Android 12 / API 31+，由 Manifest 的 android:dataExtractionRules 引用）。

  策略：学习数据（Room 数据库 yanji_study.db）允许云备份与设备迁移；
  其余目录一律不进入备份范围。

  注意：AI API Key **不在这里管辖**。它保存在 noBackupFilesDir 且用 Android Keystore
  加密，系统本身就不会备份 no-backup 目录，Keystore 密钥也永不离开设备。
  这是有意为之——凭据不应与可云备份的学习数据共享备份生命周期。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
