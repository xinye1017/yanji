<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置。
  支持局域网明文 HTTP 流量（如 Ollama、LM Studio、vLLM 或本地私有网关直连）。
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
